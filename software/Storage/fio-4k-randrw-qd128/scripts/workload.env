# Workload profile for this case.  Everything that distinguishes the two fio cases
# lives here; the scripts read these values instead of hard-coding them.
#
# The values are defaults: the continuous-integration path always uses them, and a
# local smoke run may override them through the environment (for example
# FIO_LV_SIZE_GIB=1 FIO_RAMP_TIME=5 FIO_RUNTIME=20 on a machine without /dev/kvm).
# Such an override is a functional check only and is recorded in the artifacts.
#
# The fio job itself keeps the requested [global] block verbatim; only the missing
# job stanza (target device list) is added because fio exits with "need a job
# section" when a job file contains [global] alone.

# -- workload (fixed by the requirement) --------------------------------------
: "${FIO_NUMJOBS:=4}"
: "${FIO_IODEPTH:=128}"
: "${FIO_BLOCK_SIZE:=4k}"
: "${FIO_RW:=randrw}"
: "${FIO_RWMIXWRITE:=30}"
: "${FIO_RWMIXREAD:=70}"
: "${FIO_RAMP_TIME:=300}"
: "${FIO_RUNTIME:=600}"

# -- storage: one logical volume per fio job -----------------------------------
: "${FIO_STORAGE_KEY:=fio-qd128}"
: "${FIO_LV_COUNT:=4}"
: "${FIO_LV_SIZE_GIB:=16}"

# -- reference virtual machine -------------------------------------------------
: "${FIO_VM_VCPUS:=4}"
: "${FIO_VM_MEM_MIB:=8192}"
