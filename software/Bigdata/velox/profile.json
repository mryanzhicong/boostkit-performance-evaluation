{
  "name": "velox",
  "version": "1.3.0",
  "kind": "velox",
  "spark_version": "3.5.2",
  "scale_factor": 100,
  "jar_filename": "gluten-velox-bundle-spark3.5_2.12-openEuler_24.03_aarch_64-1.3.0.jar",
  "resources": {
    "requested_executors": 200,
    "executor_cores": 8,
    "executor_memory": "5g",
    "driver_cores": 8,
    "driver_memory": "20G"
  },
  "spark_conf": {
    "spark.sql.warehouse.dir": "hdfs://server1:9000/user/hive/warehouse",
    "spark.memory.offHeap.enabled": "true",
    "spark.memory.offHeap.size": "35g",
    "spark.plugins": "org.apache.gluten.GlutenPlugin",
    "spark.gluten.loadLibFromJar": "false",
    "spark.gluten.sql.columnar.backend.lib": "velox",
    "spark.gluten.sql.columnar.maxBatchSize": "8192",
    "spark.shuffle.manager": "org.apache.spark.shuffle.sort.ColumnarShuffleManager",
    "spark.gluten.sql.columnar.physicalJoinOptimizeEnable": "true",
    "spark.gluten.sql.columnar.physicalJoinOptimizationLevel": "19",
    "spark.sql.sources.useV1SourceList": "avro",
    "spark.sql.optimizer.runtime.bloomFilter.enabled": "true",
    "spark.driver.extraClassPath": "${jar}",
    "spark.executor.extraClassPath": "${jar}",
    "spark.sql.adaptive.coalescePartitions.initialPartitionNum": "400",
    "spark.gluten.sql.orc.charType.scan.fallback.enabled": "false",
    "spark.executorEnv.LIBHDFS3_CONF": "${work}/hdfs-client.xml"
  },
  "document": {
    "filename": "大数据单机环境部署+tpcds+velox.docx",
    "sha256": "ca576397df0ec2cfb0968955daa5810e7df03033e3b0c8105b7dcfd43fdd1935"
  }
}
