{
  "name": "iceberg",
  "version": "1.5.0",
  "kind": "iceberg",
  "spark_version": "3.5.2",
  "scale_factor": 10000,
  "jar_filename": "iceberg-spark-runtime-3.5_2.12-1.5.0.jar",
  "resources": {
    "requested_executors": 2,
    "executor_cores": 8,
    "executor_memory": "23g",
    "driver_cores": 8,
    "driver_memory": "20G"
  },
  "spark_conf": {
    "spark.sql.warehouse.dir": "hdfs://server1:9000/user/hive/warehouse",
    "spark.default.parallelism": "800",
    "spark.sql.shuffle.partitions": "800",
    "spark.sql.parquet.datetimeRebaseModeInRead": "LEGACY",
    "spark.sql.parquet.datetimeRebaseModeInWrite": "LEGACY",
    "spark.sql.parquet.int96RebaseModeInRead": "LEGACY",
    "spark.sql.parquet.int96RebaseModeInWrite": "LEGACY",
    "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
    "spark.sql.catalog.iceberg": "org.apache.iceberg.spark.SparkCatalog",
    "spark.sql.catalog.iceberg.type": "hive",
    "spark.sql.catalog.iceberg.uri": "thrift://server1:9083"
  },
  "document": {
    "filename": "大数据单机环境部署+tpcds+iceberg.docx",
    "sha256": "27ec8f0f46535a1cb6726d9a51d115d3653eaf6bfaf8065fa3a3a2f417d66c57"
  }
}
