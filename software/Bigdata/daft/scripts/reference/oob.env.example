# 复制为 oob.env 并按本机修改；每个新 shell 执行前须 `source oob.env`
export MACHINE_TAG=kp950                   # 机器标识：鲲鹏 950 为 kp950，EPYC 9654 为 epyc9654
export OOB_HOME=/data/daft_oob             # 工作目录：存放 venv、Daft 源码和结果
export DATA_DIR=/data/daft_oob/tpch-data   # 数据目录：须位于本地盘，两台机器介质类型相同
export SF=100                              # 数据规模：两台机器须一致
export ROUNDS=4                            # 轮数：第 1 轮为预热，不计入结果
export PYTHON=python3.10                   # Python 解释器：版本 >= 3.10
# PyPI 不可达时设置镜像源：
# export PIP_ARGS="-i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com"
# GitHub 不可达时设置 Daft 仓库镜像地址：
# export DAFT_GIT_URL=https://<mirror>/Eventual-Inc/Daft.git
