{
  "name": "bolt",
  "version": "1.0.0-SNAPSHOT",
  "kind": "bolt",
  "spark_version": "3.5.2",
  "scale_factor": 100,
  "jar_filename": "gluten-spark3.5_2.12-1.0.0-SNAPSHOT-jar-with-dependencies.jar",
  "resources": {
    "requested_executors": 200,
    "executor_cores": 8,
    "executor_memory": "23g",
    "driver_cores": 8,
    "driver_memory": "20G"
  },
  "spark_conf": {
    "spark.memory.offHeap.enabled": "true",
    "spark.memory.offHeap.size": "35g",
    "spark.plugins": "org.apache.gluten.GlutenPlugin",
    "spark.gluten.loadLibFromJar": "false",
    "spark.gluten.sql.columnar.backend.lib": "bolt",
    "spark.gluten.sql.columnar.maxBatchSize": "8192",
    "spark.shuffle.manager": "org.apache.spark.shuffle.sort.ColumnarShuffleManager",
    "spark.gluten.sql.columnar.physicalJoinOptimizeEnable": "true",
    "spark.gluten.sql.columnar.physicalJoinOptimizationLevel": "19",
    "spark.sql.sources.useV1SourceList": "avro",
    "spark.sql.optimizer.runtime.bloomFilter.enabled": "true",
    "spark.driver.extraClassPath": "${jar}",
    "spark.executor.extraClassPath": "${jar}",
    "spark.executor.memoryOverhead": "1g",
    "spark.sql.adaptive.coalescePartitions.initialPartitionNum": "48",
    "spark.default.parallelism": "144",
    "spark.sql.shuffle.partitions": "144",
    "spark.gluten.sql.orc.charint32_type.scan.fallback.enabled": "false",
    "spark.gluten.sql.columnar.backend.velox.resizeBatches.shuffleInput": "false",
    "spark.gluten.sql.columnar.backend.bolt.resizeBatches.shuffleInput": "false",
    "spark.hadoop.fs.defaultFS": "file:///",
    "spark.sql.warehouse.dir": "hdfs://server1:9000/user/hive/warehouse",
    "spark.driver.extraJavaOptions": "-XX:+UseG1GC -XX:ActiveProcessorCount=8 -Dio.netty.tryReflectionSetAccessible=true -Duser.timezone=Asia/Shanghai",
    "spark.executor.extraJavaOptions": "-XX:+UseG1GC -XX:ActiveProcessorCount=8 -Dio.netty.tryReflectionSetAccessible=true -Duser.timezone=Asia/Shanghai",
    "spark.sql.session.timeZone": "Asia/Shanghai",
    "spark.yarn.appMasterEnv.JAVA_HOME": "${java17}",
    "spark.executorEnv.JAVA_HOME": "${java17}"
  },
  "document": {
    "filename": "大数据单机环境部署+tpcds+bolt.docx",
    "sha256": "9d4d5cfb4079df5253d627b36f0a4408fad7bf08dc70df949b65ea82efa66682"
  }
}
