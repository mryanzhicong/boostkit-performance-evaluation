{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance task status",
  "type": "object",
  "required": ["software", "version", "architecture", "status", "stage", "cleanup_status"],
  "properties": {
    "software": {"type": "string"},
    "version": {"type": "string"},
    "architecture": {"type": "string"},
    "status": {"enum": ["running", "passed", "failed"]},
    "stage": {"type": "string"},
    "failed_stage": {"type": ["string", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "cleanup_status": {"enum": ["pending", "passed", "failed"]}
  },
  "additionalProperties": true
}
