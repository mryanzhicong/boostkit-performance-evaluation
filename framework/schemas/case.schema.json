{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance software case",
  "type": "object",
  "required": ["name", "category", "enabled", "versions", "execution", "metrics"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "execution": {
      "type": "object",
      "required": ["type", "interface", "entrypoint", "expected_outputs", "timeout_minutes", "environment"],
      "properties": {
        "type": {"const": "command"},
        "interface": {"const": "four-stage"},
        "entrypoint": {"type": "string", "minLength": 1},
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "results.json"},
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_minutes": {"type": "integer", "minimum": 1},
        "environment": {"type": "object"}
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["source", "path", "unit", "direction"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "direction": {
            "enum": ["higher_is_better", "lower_is_better", "target_is_better", "neutral"]
          },
          "target": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "thresholds": {"type": "object"},
    "version_overrides": {"type": "object"}
  },
  "additionalProperties": true
}
